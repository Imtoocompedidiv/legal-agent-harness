{
  "description": "Verrous du dossier contentieux : briefing d'état, protection des pièces et du journal, contrôle des écritures, registre des lectures, passation obligatoire. Sans effet hors d'un dossier d'affaire (etat/affaire.json). Distribution publique : pseudonymisation des dossiers (scripts/pseudonymisation.py, docs/PSEUDONYMISATION.md).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py"
            ],
            "timeout": 45
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/pseudonymisation.py",
              "hook"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/pseudonymisation.py",
              "hook"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|WebFetch|WebSearch|mcp__librejustice__.*|mcp__hal__.*|mcp__shs_fr__.*|mcp__academic_papers__.*|mcp__asta__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py"
            ],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/pseudonymisation.py",
              "hook"
            ],
            "timeout": 20
          }
        ],
        "matcher": "Read|Grep|Glob|NotebookRead|Bash|PowerShell|mcp__legal_harness__.*"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py"
            ],
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__librejustice__.*|mcp__legal_harness__read_document|mcp__hal__.*|mcp__shs_fr__.*|mcp__academic_papers__.*|mcp__asta__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/pseudonymisation.py",
              "hook"
            ],
            "timeout": 20
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook.py"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}